{
  "name": "deployado-mcp",
  "version": "1.0.0",
  "description": "MCP server for Deployado PaaS — deploy, manage apps, databases, and services from any MCP client",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deployado",
    "paas",
    "deploy",
    "claude",
    "ai-agents"
  ],
  "homepage": "https://deployado.com/en/docs/mcp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deployado-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
